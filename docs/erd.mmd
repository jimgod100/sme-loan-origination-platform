        text summary
        timestamptz requested_at
        timestamptz completed_at
        int duration_ms
        timestamptz created_at
    }

    SCORE_RESULTS {
        uuid id PK
        uuid application_id FK
        numeric total_score
        varchar score_grade
        jsonb score_breakdown
        jsonb weight_config
        varchar auto_decision
        text decision_rationale
        timestamptz scored_at
        varchar scored_by_engine
    }

    LOAN_OFFERS {
        uuid id PK
        uuid application_id FK
        numeric approved_amount
        varchar currency
        int tenor_months
        numeric annual_interest_rate
        numeric monthly_payment
        numeric total_interest
        numeric total_repayment
        numeric origination_fee
        date offer_valid_until
        varchar offer_pdf_key
        varchar status
        timestamptz accepted_at
        timestamptz declined_at
        timestamptz created_at
        timestamptz updated_at
    }

    REPAYMENT_SCHEDULES {
        uuid id PK
        uuid loan_offer_id FK
        int installment_no
        date due_date
        numeric opening_balance
        numeric principal_amount
        numeric interest_amount
        numeric total_payment
        numeric closing_balance
    }

    CUSTOMERS ||--o{ LOAN_APPLICATIONS : "has"
