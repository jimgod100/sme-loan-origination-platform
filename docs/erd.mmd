erDiagram
    USERS {
        uuid id PK
        varchar username UK
        varchar email UK
        varchar password_hash
        varchar full_name
        varchar role
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    CUSTOMERS {
        uuid id PK
        varchar company_name
        varchar unified_business_no UK
        varchar legal_representative
        varchar industry_code
        date established_date
        text registered_address
        varchar contact_phone
        varchar contact_email
        varchar kyc_status
        timestamptz created_at
        timestamptz updated_at
    }

    LOAN_APPLICATIONS {
        uuid id PK
        varchar application_no UK
        uuid customer_id FK
        uuid assigned_rm_id FK
        numeric requested_amount
        varchar requested_currency
        int requested_tenor_months
        varchar loan_purpose
        varchar status
        varchar onboarding_token UK
        timestamptz onboarding_token_expires_at
        timestamptz onboarding_completed_at
        uuid reviewed_by_id FK
        timestamptz reviewed_at
        text review_notes
        text decision_reason
        timestamptz created_at
        timestamptz updated_at
    }

    APPLICATION_PARTIES {
        uuid id PK
        uuid application_id FK
        varchar party_type
        varchar full_name
        varchar id_number
        varchar nationality
        numeric ownership_pct
        boolean is_pep
        timestamptz created_at
    }

    DOCUMENTS {
        uuid id PK
        uuid application_id FK
        varchar document_type
        varchar original_filename
        varchar storage_key
        varchar content_type
        bigint file_size_bytes
        varchar checksum_sha256
        timestamptz uploaded_at
        boolean is_deleted
    }

    EXTERNAL_CHECK_RESULTS {
        uuid id PK
        uuid application_id FK
        varchar check_type
        varchar provider_name
        varchar status
        jsonb request_payload
